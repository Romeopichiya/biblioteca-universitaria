   </padding>
   <children>
      <Label text="Biblioteca Kinal" textFill="WHITE">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label text="Iniciar Sesión" textFill="#bdc3c7">
